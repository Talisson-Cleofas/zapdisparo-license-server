PORT=4000
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/zapdisparo_licenses
# Em uma instância Sandbox, use um banco separado, por exemplo zapdisparo_sandbox.
MONGODB_DB_NAME=
ADMIN_KEY=troque-essa-chave-admin
SALES_ORIGIN=https://seu-dominio.com
DEMO_DOWNLOAD_URL=https://download.zapdisparo.com/ZapDisparoSetup.exe
DOWNLOAD_URL=https://seu-dominio.com/download/ZapDisparo-Setup.exe
CUSTOMER_PANEL_URL=https://seu-dominio.com/painel
EMAIL_LOGO_URL=https://seu-dominio.com/zapdisparo-logo.png
SUPPORT_EMAIL=suporte@seu-dominio.com

# E-mail SMTP (exemplo Gmail com senha de app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua-senha-de-app
EMAIL_FROM="ZapDisparo <seuemail@gmail.com>"

MERCADO_PAGO_ACCESS_TOKEN=
# Checkout Pro hospedado. Em produção, pode usar uma credencial dedicada; no
# teste real controlado ela é obrigatória e deve ser da conta vendedora real.
MERCADO_PAGO_CHECKOUT_ACCESS_TOKEN=
# Somente no Sandbox: credencial de produção da aplicação criada pelo vendedor de teste.
MERCADO_PAGO_SUBSCRIPTION_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Assinatura secreta do webhook exclusivo do Checkout Pro.
MERCADO_PAGO_CHECKOUT_WEBHOOK_SECRET=
# Somente no Sandbox: assinatura secreta do webhook da aplicação do vendedor de teste.
MERCADO_PAGO_SUBSCRIPTION_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_URL=https://zapdisparo-license-server.onrender.com/api/payments/mercadopago/webhook
MERCADO_PAGO_CHECKOUT_WEBHOOK_URL=https://zapdisparo-license-server.onrender.com/api/payments/mercadopago/checkout/webhook
# production mantém a API Payments atual; sandbox usa a API Orders oficial de testes.
PAYMENT_ENVIRONMENT=production
MERCADO_PAGO_SANDBOX_PAYER_EMAIL=test_user_br@testuser.com
MERCADO_PAGO_SANDBOX_APPROVAL_NAME=APRO
MERCADO_PAGO_SANDBOX_SUBSCRIPTION_PAYER_EMAIL=test@testuser.com

# Página de retorno após cadastro do cartão
MERCADO_PAGO_SUBSCRIPTION_BACK_URL=https://seu-dominio.com/sales.html
MERCADO_PAGO_CHECKOUT_BACK_URL=https://seu-dominio.com/sales.html

# Compra real de homologação: somente Sandbox, URL com sandbox/homologacao e R$ 1,00.
# Deixe ambos vazios/zero em produção para manter os preços oficiais.
PAYMENT_TEST_MODE=
CHECKOUT_TEST_AMOUNT_CENTS=0

# Sprint 5.0.8 — job diário de lembretes
LICENSE_REMINDER_TIMEZONE=America/Sao_Paulo
LICENSE_REMINDER_HOUR=8
LICENSE_REMINDER_MINUTE=0

# Sprint 5.0.10 - Segurança
# Gere uma chave aleatória forte, com pelo menos 32 caracteres.
LICENSE_SIGNING_SECRET=troque-por-uma-chave-aleatoria-com-64-caracteres
# Gere o par Ed25519 com: npm run keys:generate
LICENSE_PRIVATE_KEY_B64=

# Rate limiting das APIs públicas de ativação/validação
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=60

# Backup automático local compactado (.json.gz)
BACKUP_ENABLED=true
BACKUP_HOUR=2
BACKUP_MINUTE=0
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=./backups
